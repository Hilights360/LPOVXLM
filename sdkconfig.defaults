CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Wi-Fi/IP handlers share sys_evt; leave headroom for IDF's own event handlers.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_FS_LOCK=8
# The ESP32-S3's SDMMC host has no PSRAM DMA path, so FatFs buffers in external
# RAM force one 512-byte CMD17 per sector with a bounce allocation each time.
# Keeping them internal is what IDF's own help calls optimizing for performance.
CONFIG_FATFS_ALLOC_PREFER_EXTRAM=n
# SD cards report 512-byte sectors and no FatFs volume lives on flash, so IDF's
# 4096-byte default only inflates every open file's sector cache by 3.5 KiB.
CONFIG_FATFS_SECTOR_512=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# The application enables its playback task watchdog from the saved setting.
# CONFIG_ESP_TASK_WDT_INIT is not set
# Save crash evidence in the existing 64 KiB coredump partition for Wi-Fi recovery.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=4
CONFIG_ESP_COREDUMP_STACK_SIZE=2048
